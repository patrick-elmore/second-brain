{
  "service_name": "SecondBrainHttpMcp",
  "display_name": "Second Brain HTTP MCP",
  "description": "Persistent-session knowledge retrieval over local source folders",
  "http_host": "0.0.0.0",
  "http_port": 9998,
  "mcp_timeout": 120,
  "log_level": "INFO",
  "enable_logging": true,

  "second_brain": {
    "anthropic_api_key_env": "ANTHROPIC_API_KEY",
    "fts_db_path": "index/fts.db",
    "requests_db_path": "index/requests.db",
    "session_state_path": "index/session-state.json",
    "sources_config": "config/sources.json",

    "default_model": "claude-haiku-4-5",
    "escalation_model": "claude-sonnet-4-6",
    "compact_threshold_tokens": 150000,

    "state_persist_every_n_messages": 5,
    "state_backup_count": 5,

    "index_max_bytes": 500000,
    "index_refresh_interval_seconds": 3600,

    "max_tool_turns": 25,
    "max_read_file_bytes": 131072,
    "base_output_tokens": 8192,
    "compactor_max_output_tokens": 8192,

    "summarizer_content_budget_chars": 80000,
    "summarizer_input_char_limits": {
      "1on1": 24000,
      "transcript": 20000,
      "standup": 6000,
      "planning": 16000,
      "note": 8000,
      "default": 12000
    },

    "search_max_snippet_tokens": 64,
    "search_per_variant_overfetch_min": 30,
    "search_per_variant_overfetch_max": 50,

    "index_anomaly_change_threshold": 200,

    "vertex_base_url": "",

    "summarize_safety_buffer_seconds": 30
  }
}
